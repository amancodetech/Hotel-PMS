{
  "name": "hotel-pms-saas",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "build": "pnpm contracts:generate && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:integration": "pnpm build && node --env-file=.env scripts/integration.mjs",
    "contracts:check": "node scripts/contracts.mjs",
    "contracts:generate": "openapi-typescript docs/contracts/v1.openapi.json -o packages/contracts/src/v1.generated.ts && openapi-typescript docs/contracts/phase3.openapi.json -o packages/contracts/src/phase3.generated.ts && openapi-typescript docs/contracts/phase4.openapi.json -o packages/contracts/src/phase4.generated.ts && openapi-typescript docs/contracts/phase5.openapi.json -o packages/contracts/src/phase5.generated.ts && openapi-typescript docs/contracts/phase6.openapi.json -o packages/contracts/src/phase6.generated.ts && openapi-typescript docs/contracts/phase7.openapi.json -o packages/contracts/src/phase7.generated.ts && openapi-typescript docs/contracts/phase8.openapi.json -o packages/contracts/src/phase8.generated.ts && openapi-typescript docs/contracts/phase9.openapi.json -o packages/contracts/src/phase9.generated.ts && openapi-typescript docs/contracts/phase10.openapi.json -o packages/contracts/src/phase10.generated.ts && openapi-typescript docs/contracts/phase11.openapi.json -o packages/contracts/src/phase11.generated.ts && openapi-typescript docs/contracts/phase12.openapi.json -o packages/contracts/src/phase12.generated.ts && openapi-typescript docs/contracts/set.openapi.json -o packages/contracts/src/set.generated.ts",
    "dev": "pnpm build && node --env-file=.env scripts/dev.mjs",
    "dev:start": "node --env-file=.env scripts/dev-start.mjs",
    "api:start": "node --env-file=.env scripts/api-start.mjs",
    "api:stop": "node --env-file=.env scripts/api-stop.mjs",
    "dev:stop": "node scripts/stop-dev.mjs",
    "env:init": "node scripts/init-env.mjs",
    "db:roles": "node scripts/db-roles.mjs",
    "identity:local": "node --env-file=.env scripts/identity.mjs",
    "provision:local": "node --env-file=.env scripts/provision-local.mjs",
    "demo:sagara": "node --env-file=.env scripts/seed-sagara-demo.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:stop": "node scripts/infra.mjs stop",
    "infra:status": "node scripts/infra.mjs status",
    "test:containers": "pnpm build && node --env-file=.env scripts/testcontainers.mjs",
    "test:distribution": "pnpm build && node --env-file=.env scripts/test-distribution.mjs",
    "test:distribution:fast": "node --env-file=.env scripts/test-distribution.mjs",
    "test:identity": "pnpm build && node --env-file=.env scripts/test-identity.mjs",
    "test:identity:fast": "node --env-file=.env scripts/test-identity.mjs",
    "test:property": "pnpm build && node --env-file=.env scripts/test-property.mjs",
    "test:property:fast": "node --env-file=.env scripts/test-property.mjs",
    "db:check": "pnpm --filter @hotel/backend db:check",
    "db:migrate": "pnpm --filter @hotel/backend db:migrate",
    "check": "pnpm build && pnpm contracts:check && pnpm typecheck && pnpm lint && pnpm format:check && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "checksums": "node scripts/checksums.mjs",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:phase3": "node --env-file=.env scripts/phase3-visual.mjs",
    "visual:phase4": "node --env-file=.env scripts/phase4-visual.mjs",
    "visual:phase5": "node --env-file=.env scripts/phase5-visual.mjs",
    "visual:phase6": "node --env-file=.env scripts/phase6-visual.mjs",
    "visual:phase7": "node --env-file=.env scripts/phase7-visual.mjs",
    "visual:phase8": "node --env-file=.env scripts/phase8-visual.mjs",
    "visual:phase9": "node --env-file=.env scripts/phase9-visual.mjs",
    "visual:phase10": "node --env-file=.env scripts/phase10-visual.mjs",
    "visual:phase11": "node --env-file=.env scripts/phase11-visual.mjs",
    "visual:phase12": "node --env-file=.env scripts/phase12-visual.mjs",
    "visual:set01": "node --env-file=.env scripts/set01-visual.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.0",
    "playwright": "1.59.1",
    "prettier": "3.9.6",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
