          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      },
      "CommitmentResult": {
        "type": "object",
        "required": [
          "reservation_id",
          "state",
          "version",
          "item_ids",
          "inventory_version",
          "replayed"
        ],
        "properties": {
          "reservation_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "item_ids": {
            "type": "array",
