{
  "openapi": "3.1.0",
  "info": {
    "title": "HOTEL PMS SAAS - Phase 6 implemented operations",
    "version": "0.14.0",
    "description": "Operations implemented in Phase 6 package P06-01 (reservation reads and unconfirmed drafts, guest registry). Confirmation/modification/cancellation and revision consumption remain unimplemented."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hotel_session"
      }
    },
    "parameters": {
      "TenantId": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "PropertyId": {
        "name": "propertyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ReservationId": {
        "name": "reservationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "GuestId": {
        "name": "guestId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      },
      "Csrf": {
        "name": "x-csrf-token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 32
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "ItemId": {
        "name": "itemId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "RevisionId": {
        "name": "revisionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Fixed error code, localized message key, correlation id and bounded details without secrets",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Period": {
        "type": "object",
        "required": [
          "arrival",
          "departure"
        ],
        "properties": {
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "departure": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Occupancy": {
        "type": "object",
        "required": [
          "adults"
        ],
        "properties": {
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "child_ages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            }
          }
        }
      },
      "ReservationSummary": {
        "type": "object",
        "required": [
          "id",
          "source",
          "state",
          "version",
          "item_states",
          "item_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "enum": [
              "DIRECT",
              "OTA",
              "IMPORT"
            ]
          },
          "state": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "item_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "item_count": {
            "type": "integer"
          }
        }
      },
      "ReservationList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ReservationSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "StaySegmentView": {
        "type": "object",
        "required": [
          "id",
          "start_date",
          "end_date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ReservationItemView": {
        "type": "object",
        "required": [
          "id",
          "period",
          "occupancy",
          "quantity",
          "state",
          "version",
          "segments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "occupancy": {
            "$ref": "#/components/schemas/Occupancy"
          },
          "quantity": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaySegmentView"
            }
          }
        }
      },
      "ReservationGuestView": {
        "type": "object",
        "required": [
          "guest_id",
          "role",
          "full_name"
        ],
        "properties": {
          "guest_id": {
            "type": "string",
            "format": "uuid"
          },
          "item_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "LEAD",
              "ACCOMPANYING"
            ]
          },
          "full_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "gender": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "FEMALE",
              "MALE",
              null
            ]
          }
        }
      },
      "ReservationDetail": {
        "type": "object",
        "required": [
          "reservation",
          "items",
          "guests"
        ],
        "properties": {
          "reservation": {
            "type": "object",
            "additionalProperties": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationItemView"
            }
          },
          "guests": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ReservationGuestView"
            },
            "description": "null when the caller lacks guest.read"
          }
        }
      },
      "DraftItemInput": {
        "type": "object",
        "required": [
          "period",
          "occupancy"
        ],
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "occupancy": {
            "$ref": "#/components/schemas/Occupancy"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "DraftGuestInput": {
        "type": "object",
        "required": [
          "guest_id"
        ],
        "additionalProperties": false,
        "properties": {
          "guest_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "LEAD",
              "ACCOMPANYING"
            ]
          }
        }
      },
      "DraftInput": {
        "type": "object",
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "DIRECT",
              "OTA",
              "IMPORT"
            ]
          },
          "channel_connection_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "external_booking_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/DraftItemInput"
            }
          },
          "guests": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/DraftGuestInput"
            }
          }
        }
      },
      "DraftResult": {
        "type": "object",
        "required": [
          "reservation"
        ],
        "properties": {
          "reservation": {
            "type": "object",
            "required": [
              "id",
              "source",
              "state",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "external_booking_key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "Guest": {
        "type": "object",
        "required": [
          "id",
          "full_name",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "full_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer"
          },
          "gender": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "FEMALE",
              "MALE",
              null
            ]
          }
        }
      },
      "GuestList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Guest"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "GuestInput": {
        "type": "object",
        "required": [
          "full_name"
        ],
        "additionalProperties": false,
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 320
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 2,
            "maxLength": 2
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "gender": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "FEMALE",
              "MALE",
              null
            ]
          }
        }
      },
      "GuestResult": {
        "type": "object",
        "required": [
          "guest"
        ],
        "properties": {
          "guest": {
            "$ref": "#/components/schemas/Guest"
          }
        }
      },
      "ConfirmItemInput": {
        "type": "object",
