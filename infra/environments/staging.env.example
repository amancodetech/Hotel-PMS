# Staging deployment profile (example only, no secrets)
# Validated by: node scripts/production-config-check.mjs --profile=staging --env-file=infra/environments/staging.env.example
# Values below are placeholders; the check must FAIL until a real secret source and TLS endpoints exist.
DEPLOYMENT_PROFILE=staging
NODE_ENV=production

API_HOST=api.staging.invalid
API_PORT=8443
WORKER_PORT=8444
WEB_PORT=8445
WEB_ORIGIN=https://web.staging.invalid
API_ORIGIN=https://api.staging.invalid

# TLS required: sslmode must be require|verify-ca|verify-full and passwords come from the secret source.
DATABASE_URL=postgresql://hotel_owner@db.staging.invalid:5432/hotel?sslmode=require
API_DATABASE_URL=postgresql://hotel_api@db.staging.invalid:5432/hotel?sslmode=require
WORKER_DATABASE_URL=postgresql://hotel_worker@db.staging.invalid:5432/hotel?sslmode=require
MIGRATION_DATABASE_URL=postgresql://hotel_migrator@db.staging.invalid:5432/hotel?sslmode=require

REDIS_URL=rediss://hotel@redis.staging.invalid:6379/0

KEYCLOAK_ISSUER=https://identity.staging.invalid/realms/hotel
KEYCLOAK_CLIENT_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=480

SECRET_SOURCE=aws-secrets-manager
RLS_ENFORCEMENT=require-force
TENANT_CONTEXT_MODE=session
LOG_LEVEL=info

OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.staging.invalid
ALERT_WEBHOOK_URL=https://alerts.staging.invalid/hooks/hotel

BACKUP_TARGET=s3://hotel-staging-backups/postgres
BACKUP_SCHEDULE_CRON=*/15 * * * *
BACKUP_RETENTION_DAYS=14
RESTORE_RPO_TARGET_MINUTES=15
RESTORE_RTO_TARGET_MINUTES=60

DISTRIBUTION_WORKER=off
# When DISTRIBUTION_WORKER=on, LIVE_PROVIDER_KEYS and CHANNEL_LIVE_AUTHORIZATION_REF are required.
# LIVE_PROVIDER_KEYS=channex
# CHANNEL_LIVE_AUTHORIZATION_REF=
