# Production deployment profile (example only, no secrets)
# Validated by: node scripts/production-config-check.mjs --profile=production --env-file=infra/environments/production.env.example
# This file must FAIL the check while secrets and authorizations are absent; that is the fail-closed proof.
DEPLOYMENT_PROFILE=production
NODE_ENV=production

API_HOST=api.hotel.invalid
API_PORT=8443
WORKER_PORT=8444
WEB_PORT=8445
WEB_ORIGIN=https://app.hotel.invalid
API_ORIGIN=https://api.hotel.invalid

DATABASE_URL=postgresql://hotel_owner@db.hotel.invalid:5432/hotel?sslmode=verify-full
API_DATABASE_URL=postgresql://hotel_api@db.hotel.invalid:5432/hotel?sslmode=verify-full
WORKER_DATABASE_URL=postgresql://hotel_worker@db.hotel.invalid:5432/hotel?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://hotel_migrator@db.hotel.invalid:5432/hotel?sslmode=verify-full

REDIS_URL=rediss://hotel@redis.hotel.invalid:6379/0

KEYCLOAK_ISSUER=https://identity.hotel.invalid/realms/hotel
KEYCLOAK_CLIENT_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=480

SECRET_SOURCE=aws-secrets-manager
RLS_ENFORCEMENT=require-force
TENANT_CONTEXT_MODE=session
LOG_LEVEL=info

OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.hotel.invalid
ALERT_WEBHOOK_URL=https://alerts.hotel.invalid/hooks/hotel

BACKUP_TARGET=s3://hotel-production-backups/postgres
BACKUP_SCHEDULE_CRON=*/15 * * * *
BACKUP_RETENTION_DAYS=35
RESTORE_RPO_TARGET_MINUTES=15
RESTORE_RTO_TARGET_MINUTES=60

DISTRIBUTION_WORKER=off
# LIVE_PROVIDER_KEYS=channex
# CHANNEL_LIVE_AUTHORIZATION_REF=

# Required by the profile (must stay empty until the user authorizes externally):
COST_APPROVAL_REF=
PRODUCTION_AUTHORIZATION_REF=
RESTORE_TEST_REF=
