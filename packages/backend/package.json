{
  "name": "@hotel/backend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:check": "node --env-file=../../.env node_modules/@mikro-orm/cli/cli.js debug --config dist/persistence/mikro-orm.config.js",
    "db:migrate": "node --env-file=../../.env node_modules/@mikro-orm/cli/cli.js migration:up --config dist/persistence/mikro-orm.config.js",
    "watch": "tsc --watch -p tsconfig.json"
  },
  "dependencies": {
    "@hotel/contracts": "workspace:*",
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/migrations": "7.2.0",
    "@mikro-orm/postgresql": "7.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.222.0",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "openid-client": "6.8.8",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.0",
    "tsx": "4.23.13"
  }
}
